lass="svgicon icon_vote_up" version="1.1" aria-hidden width="20" height="20" role="img"><polygon points="2 18 12 6 22 18" /></svg></a> <a href="https://itch.io/login?return_to=https%3A%2F%2Ffightswithbears.itch.io%2F2d-topdown-survival-character&amp;intent=community" title="Vote down" class="vote_down_btn vote_btn" data-register_action="community_vote"><svg viewBox="0 0 24 24" class="svgicon icon_vote_down" version="1.1" aria-hidden width="20" height="20" role="img"><polygon points="2 6 12 18 22 6" /></svg></a></div><a class="avatar_container" href="https://itch.io/profile/clobie"><div style="background-image: url(https://img.itch.zone/aW1nLzE5ODA2ODYyLnBuZw==/25x25%23/UtzOUz.png)" class="post_avatar"></div></a><div class="post_header"><span class="post_author"><a href="https://itch.io/profile/clobie">clobie</a></span><span title="2026-08-03 07:48:29" class="post_date"><a href="https://itch.io/post/16926043">55 days ago</a></span><span class="vote_counts"><span class="upvotes">(+1)</span></span></div><div class="post_content"><div dir="auto" class="post_body user_formatted"><p>hey there, I used your survivor character in my game. thanks!<br><a href="https://clobie.itch.io/boomer-strike">https://clobie.itch.io/boomer-strike</a></p></div><div class="post_footer"><a class="post_action reply_btn" href="https://itch.io/login?return_to=https%3A%2F%2Ffightswithbears.itch.io%2F2d-topdown-survival-character&amp;intent=community" data-register_action="community_reply">Reply</a></div></div></div></div><div id="post-14888856" class="community_post has_vote_column has_replies" data-post="{&quot;user_id&quot;:14886070,&quot;id&quot;:14888856}"><div class="post_grid"><div class="post_votes"><a href="https://itch.io/login?return_to=https%3A%2F%2Ffightswithbears.itch.io%2F2d-topdown-survival-character&amp;intent=community" title="Vote up" class="vote_up_btn vote_btn" data-register_action="community_vote"><svg viewBox="0 0 24 24" class="svgicon icon_vote_up" version="1.1" aria-hidden width="20" height="20" role="img"><polygon points="2 18 12 6 22 18" /></svg></a> <a href="https://itch.io/login?return_to=https%3A%2F%2Ffightswithbears.itch.io%2F2d-topdown-survival-character&amp;intent=community" title="Vote down" class="vote_down_btn vote_btn" data-register_action="community_vote"><svg viewBox="0 0 24 24" class="svgicon icon_vote_down" version="1.1" aria-hidden width="20" height="20" role="img"><polygon points="2 6 12 18 22 6" /></svg></a></div><a class="avatar_container" href="https://itch.io/profile/wizzy-34"><div style="background-image: url(/static/images/frog.png)" class="post_avatar"></div></a><div class="post_header"><span class="post_author"><a href="https://itch.io/profile/wizzy-34">Wizzy_34</a></span><span title="2025-11-26 16:08:41" class="post_date"><a href="https://itch.io/post/14888856">304 days ago</a></span> <span class="edit_message">(1 edit)</span> <span class="vote_counts"></span></div><div class="post_content"><div dir="auto" class="post_body user_formatted"><p>Hey there,nice sprites,if you can, please make the full body visible so there can be animations for the player,I know it&#x27;s a lot of work but it would be most appreciated&nbsp;</p></div><div class="post_footer"><a class="post_action reply_btn" href="https://itch.io/login?return_to=https%3A%2F%2Ffightswithbears.itch.io%2F2d-topdown-survival-character&amp;intent=community" data-register_action="community_reply">Reply</a></div></div></div></div><div class="community_post_replies top_level_replies"><div id="post-14978851" class="community_post has_vote_column is_reply" data-post="{&quot;user_id&quot;:4901000,&quot;id&quot;:14978851}"><div class="post_grid"><div class="post_votes"><a href="https://itch.io/login?return_to=https%3A%2F%2Ffightswithbears.itch.io%2F2d-topdown-survival-character&amp;intent=community" title="Vote up" class="vote_up_btn vote_btn" data-register_action="community_vote"><svg viewBox="0 0 24 24" class="svgicon icon_vote_up" version="1.1" aria-hidden